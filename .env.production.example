# =============================================================================
# Sentinel SaaS — Production Environment Variables
# =============================================================================
# Copiar a .env.production y reemplazar los valores
# GENERAR VALORES SEGUROS: openssl rand -hex 32
# =============================================================================

# --- PostgreSQL ---
DB_USER=sentinel
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- MongoDB ---
MONGO_USER=sentinel
MONGO_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- RabbitMQ ---
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Kong API Gateway ---
KONG_DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- JWT (DEBE ser idéntico en todos los servicios) ---
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# --- MercadoPago (PRODUCCIÓN) ---
# Obtener de: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_16
N8N_HOST=sentinel.crudzaso.com
N8N_WEBHOOK_URL=https://sentinel.crudzaso.com/n8n

# --- Frontend ---
FRONTEND_API_URL=https://service.sentinel.crudzaso.com/api

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_password

# --- Google OAuth ---
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# --- App URL (para redirects, magic links, etc.) ---
APP_URL=https://sentinel.crudzaso.com

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=https://sentinel.crudzaso.com
